generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum UserRole {
  customer
  admin
}

enum AccountStatus {
  under_review
  available
  rented
  trial
  maintenance
  under_construction
  construction_immature
  unavailable
  retired
  removed
}

enum RentalStatus {
  active
  expired
  cancelled
  payment_failed
  pending_access
  replaced
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  passwordHash      String?    @map("password_hash")
  fullName          String     @map("full_name")
  role              UserRole   @default(customer)
  stripeCustomerId  String?    @unique @map("stripe_customer_id")
  status            UserStatus @default(active)
  emailVerified     DateTime?  @map("email_verified")
  contactNumber     String?    @map("contact_number")
  company           String?    @map("company")
  industry          String?    @map("industry")
  image             String?
  usdcBalance       Decimal    @default(0) @map("usdc_balance") @db.Decimal(18, 6)
  dismissAppModalUntil DateTime? @map("dismiss_app_modal_until")
  paymentDetails    String?    @map("payment_details")
  referralSource    String?    @map("referral_source")
  vettingStartedAt  DateTime?  @map("vetting_started_at") // opened the vetting form at checkout (for drop-off tracking)
  vettedAt          DateTime?  @map("vetted_at")      // renter vetting completed + agreed to use policy
  vettingInfo       Json?      @map("vetting_info")   // { company, website, role, useCase, tools }
  vettingReview     String?    @map("vetting_review") // admin's personal check: pending | verified | flagged
  stripePaymentMethodId String? @map("stripe_payment_method_id")
  cardBrand         String?    @map("card_brand")
  cardLast4         String?    @map("card_last4")
  // Email a renter's GoLogin profile shares are sent to. Defaults to the account email;
  // set this when the renter accesses GoLogin under a DIFFERENT account (e.g. ProfilePartner
  // bills as lydia@ but their GoLogin workspace is support@profilepartner.net). Sharing to an
  // address that isn't a GoLogin user fails with a 400, so this must be their GoLogin login.
  gologinShareEmail String?    @map("gologin_share_email")
  // Twilio-style auto-recharge: when the wallet balance drops below `autoRechargeThreshold`,
  // the daily cron charges the saved card for `autoRechargeAmount` and credits the wallet.
  // `autoRechargeEnabled` is the renter's explicit consent to automatic card charges — no
  // card is ever auto-charged unless this is on. Off => wallet draws down + manual top-up only.
  autoRechargeEnabled   Boolean  @default(false) @map("auto_recharge_enabled")
  autoRechargeThreshold Decimal? @map("auto_recharge_threshold") @db.Decimal(10, 2)
  autoRechargeAmount    Decimal? @map("auto_recharge_amount") @db.Decimal(10, 2)
  isTest            Boolean    @default(false) @map("is_test")
  // "Shadow renter" (e.g. Apex Strategy): rents idle accounts at a flat rate WITHOUT
  // removing them from the catalogue. A real customer can still rent the same account,
  // which yields (ends) the shadow rental. Flagged on the User; each of their rentals
  // inherits it via Rental.isShadow.
  isShadowRenter    Boolean    @default(false) @map("is_shadow_renter")
  // Max rentals a renter may start per calendar day (anti-burn speed limit). Admin-set
  // per renter in /admin/customers; enforced in checkout. Shadow renters are exempt;
  // replacements (Phase 2) don't count. Default 5.
  dailyRentalLimit  Int        @default(5) @map("daily_rental_limit")
  // Tiered credential access: when ON, this renter also sees the account login email,
  // password and a live 2FA code on their dashboard (for ALL accounts they rent), not just
  // the GoLogin share. Default OFF = GoLogin-only, as it has always been. Admin-toggled
  // per renter in /admin/customers; each toggle is logged.
  credentialAccess  Boolean    @default(false) @map("credential_access")
  reengageNudgeAt    DateTime? @map("reengage_nudge_at")    // dormant-signup re-engagement email 1 sent
  reengageFollowupAt DateTime? @map("reengage_followup_at") // dormant-signup re-engagement email 2 sent
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  submittedApplications AmbassadorApplication[] @relation("ApplicationSubmitter")
  rentals           Rental[]
  waitlistEntries   Waitlist[]
  sessions          Session[]
  transactions      Transaction[]
  depositAddress    DepositAddress?
  person            Person?

  @@map("users")
}

// Admin-managed voucher / discount codes applied at checkout (and locked onto the rental
// so renewals keep the discounted rate). Three kinds via `type`:
//   - "percent": `value` = % off the list price (0-100)
//   - "fixed":   `value` = $ off the list price
//   - "flat":    `value` = the exact $/mo price the renter pays, overriding list price
// DB-backed (not Stripe coupons) because our rentals bill from the wallet, not a Stripe sub.
model DiscountCode {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  type           String    // percent | fixed | flat | tiered
  value          Decimal   @db.Decimal(10, 2)
  // For type "tiered": the price book, as [{ verified, minConnections, price }]. Each
  // account is priced by the matching tier (its verified flag + connection count),
  // overriding the list price — used for partner deals like ProfilePartner's 4 tiers.
  tiers          Json?
  active         Boolean   @default(true)
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  expiresAt      DateTime? @map("expires_at")
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("discount_codes")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("verification_codes")
}

model LinkedInAccount {
  codeLinks AccountCodeLink[]
  primaryEmailRecoveries PrimaryEmailRecovery[]
  proxyPurchaseAttempt ProxyPurchaseAttempt?
  selfServiceOnboarding SelfServiceOnboarding?
  id                    String        @id @default(uuid()) @db.Uuid
  gologinProfileId      String?       @map("gologin_profile_id")
  // Which GoLogin account hosts this profile: "master" (info@ortus, legacy rentals)
  // or "klabber" (info@klabber.co, all new inventory). Picks the API token to use.
  gologinAccount        String        @default("master") @map("gologin_account")
  linkedinName          String        @map("linkedin_name")
  linkedinHeadline      String?       @map("linkedin_headline")
  linkedinUrl           String?       @map("linkedin_url")
  connectionCount       Int           @default(0) @map("connection_count")
  industry              String?
  location              String?
  profileScreenshotUrl  String?       @map("profile_screenshot_url")
  profilePhotoUrl       String?       @map("profile_photo_url")
  proxyHost             String?       @map("proxy_host")
  proxyPort             Int?          @map("proxy_port")
  proxyUsername         String?       @map("proxy_username")
  proxyPassword         String?       @map("proxy_password")
  proxyLocation         String?       @map("proxy_location")  // geo of the proxy egress (e.g. "US", "United States · New York") — for verifying geo-match to the account
  // Login credentials for the ambassador's LinkedIn account (we hold the login).
  // Admin-only by default; exposed to a renter ONLY when that renter has User.credentialAccess
  // set (tiered access), and only for accounts they actively rent. loginEmail = the email WE sign in with
  // (our klabber.co / ortus.solutions address, added at onboarding); personalEmail =
  // the ambassador's own original email on the account; workEmail = recovery/secondary.
  loginEmail            String?       @map("login_email")
  personalEmail         String?       @map("personal_email")
  accountPassword       String?       @map("account_password")
  twoFactor             String?       @map("two_factor")
  twoFactorReceivedAt   DateTime?     @map("two_factor_received_at")
  // Set automatically whenever a rental ends (the outgoing renter had this code).
  // While true, the account can't be set back to "available" — the 2FA must be
  // rotated and this cleared first.
  twoFactorResetNeeded  Boolean       @default(false) @map("two_factor_reset_needed")
  workEmail             String?       @map("work_email")
  status                AccountStatus @default(available)
  monthlyPrice          Decimal       @default(0) @map("monthly_price") @db.Decimal(10, 2)
  ambassadorPayment     Decimal       @default(0) @map("ambassador_payment") @db.Decimal(10, 2)
  accountAgeMonths      Int?          @map("account_age_months")
  linkedinJoinedAt      DateTime?     @map("linkedin_joined_at") // "Joined LinkedIn" month from About this member — recorded at Level-4 build for the record
  connectionHistory     Json?         @map("connection_history") // append-only [{ at: ISO, count: number, note?: "rented"|"returned" }] — connection growth over time
  hasSalesNav           Boolean       @default(false) @map("has_sales_nav")
  listed                Boolean       @default(true)
  // Inventory partition. "main" = normal rentable catalogue. "ortus" = brought in by an
  // Ortus referrer (Referrer.type = "ortus"): hidden from the public catalogue and from
  // other shadow renters, and auto-owned by info@ortus.solutions (a $0 rental).
  inventoryPool         String        @default("main") @map("inventory_pool")
  gologinShareLink      String?       @map("gologin_share_link")
  linkedinAccountHealth String?       @default("unchecked") @map("linkedin_account_health")
  healthCheckedAt       DateTime?     @map("health_checked_at")
  restrictedAt          DateTime?     @map("restricted_at")  // admin-set: account restricted by LinkedIn, recovering
  warmupStartedAt       DateTime?     @map("warmup_started_at") // set while the account is being warmed up (Ortus app); null = not warming. Orthogonal to status.
  maturingStartedAt     DateTime?     @map("maturing_started_at") // AUTO (reconcile-maturing cron): set while a live LinkedVelocity maturing campaign is running for this profile; null = not maturing. Drives the 🔥 badge on Inventory + Pipeline. Never set/cleared by hand.
  profileBuild          Json?         @map("profile_build") // Level-4 generated profile (headline/about/2 past PH roles/PH school/US location) to copy-paste into LinkedIn
  // admin-set (from the Replacements workqueue): LinkedIn restriction is permanent — the
  // account can't be recovered. Renters see "Permanently restricted" and can only replace it.
  permanentlyRestricted Boolean       @default(false) @map("permanently_restricted")
  // admin-set payout hold: account is inaccessible / paused (NOT a LinkedIn restriction).
  // While set, the owner's monthly payout is held — out of the "due" chase on Payouts II —
  // until cleared. Reason is free text (e.g. "Inaccessible — can't log in").
  payoutHoldReason      String?       @map("payout_hold_reason")
  payoutHeldAt          DateTime?     @map("payout_held_at")
  // LV handler (PoC) for an inventory-only account that has no ambassador application
  // (e.g. Ortus-owned accounts handled by Ton). For accounts WITH an application the PoC
  // lives on the application; this covers the account-only pipeline rows.
  poc                   String?       @map("poc")
  // Append-only history of restriction/recovery events so repeat restrictions are
  // visible (restrictedAt only holds the CURRENT open one and is wiped on recover).
  // Array of { at: ISO, event: "restricted" | "recovered", note?, creditedDays? }.
  restrictionLog        Json?         @map("restriction_log")
  trialEndsAt           DateTime?     @map("trial_ends_at")   // set when status=trial: a 3-day inventory hold; past this = "trial expired", awaiting admin mark-back
  // Short-term reservation: while heldUntil is in the future the account is hidden from every
  // catalogue (public + unlisted) and the normal checkout, so it can't be snagged. Status stays
  // "available" — a cron clears expired holds back to visible. Rentable only via the direct link.
  heldUntil             DateTime?     @map("held_until")
  heldFor               String?       @map("held_for")        // who it's reserved for (name/note, or the catalogue name for self-serve)
  heldBy                String?       @map("held_by")          // admin email, or "reserve:<catalogue>" for self-serve
  heldAt                DateTime?     @map("held_at")
  // Rental-ready housekeeping done before an account is listed Available (hard gate). Shape:
  // { <itemKey>: { done: bool, by: string, at: ISO } }. See lib/rental-ready.ts for the items.
  rentalReadyChecklist  Json?         @map("rental_ready_checklist")
  // End-of-rental lockdown checklist (opened when a rental ends). Shape in lib/offboarding.ts:
  // { open, shared:{gologin,totp,password,workEmail}, ticks:{...}, openedBy/At, closedBy/At }.
  offboarding           Json?         @map("offboarding")
  // Internal proof the account is real (email-exchange screenshot links / notes).
  // Never shown publicly — shared with a renter per-case.
  verificationProof     String?       @map("verification_proof")
  linkedinVerified      Boolean       @default(false) @map("linkedin_verified")
  // Auto-provisioning flag (set by provisionAccount when no proxy could be assigned):
  // null = fine / provisioned, "ready_to_buy_cheap" = unverified needs a residential
  // purchase, "needs_proxy6" = verified needs a datacenter proxy bought.
  provisionStatus       String?       @map("provision_status")
  provisionCheckedAt    DateTime?     @map("provision_checked_at")
  notes                 String?
  removedAt             DateTime?     @map("removed_at")
  removedBy             String?       @map("removed_by")
  // Off-platform crypto rent tracking: the renter pays a daily rate straight into
  // this wallet. A daily cron scans the chain for new transfers, records them as
  // CryptoPayment rows, and flags the account when payments fall behind the rate.
  paymentWallet         String?       @map("payment_wallet")           // receiving address
  paymentNetwork        String?       @map("payment_network")          // "bsc" | "tron" (add checkers as needed)
  paymentToken          String?       @map("payment_token")            // e.g. "USDT"
  paymentDailyRate      Decimal?      @map("payment_daily_rate") @db.Decimal(10, 2)
  paymentTermsLabel     String?       @map("payment_terms_label")      // human terms, e.g. "$35/week" (display; dailyRate drives the maths)
  manualPaidUntil       DateTime?     @map("manual_paid_until")         // manual-tracked rentals: paid-through date the admin sets; past this = assume overdue
  paymentTrackedFrom    DateTime?     @map("payment_tracked_from")     // rent accrues from here
  paymentTelegramChatId String?       @map("payment_telegram_chat_id") // renter's TG @username/chat id for overdue nudges
  paymentWhatsapp       String?       @map("payment_whatsapp")         // renter's WhatsApp number (E.164, e.g. +39351...) — sent by the Mac-side agent
  lastNudgeAt           DateTime?     @map("last_nudge_at")            // last overdue nudge sent (any channel) — dedup so repeat scans never double-send
  // One renter paying for multiple accounts with a single combined payment.
  // The secondary account (this one) has no wallet of its own and is skipped by
  // the payment cron entirely — its paid/overdue status is mirrored client-side
  // from the primary account it points at, so both always agree without ever
  // trying to split one on-chain balance across two independent ledgers.
  paymentLinkedAccountId String?      @map("payment_linked_account_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  rentals               Rental[]
  waitlistEntries       Waitlist[]
  cryptoPayments        CryptoPayment[]
  mailEvents            AccountMailEvent[]

  @@map("linkedin_accounts")
}

// Captured LinkedIn account-security emails (new logins, password/email/name/photo changes,
// location changes, restrictions, email-verify) for accounts whose login email is on our
// domains. One row per inbound email (deduped by emailId). Surfaced in the Inventory v2
// "Account mail" tab. Body is sanitized (forwardedText) before storage.
model AccountMailEvent {
  id                String          @id @default(uuid()) @db.Uuid
  emailId           String          @unique @map("email_id")
  linkedinAccountId String          @map("linkedin_account_id") @db.Uuid
  account           LinkedInAccount @relation(fields: [linkedinAccountId], references: [id], onDelete: Cascade)
  receivedAt        DateTime        @map("received_at")
  fromAddr          String          @map("from_addr")
  toAddr            String          @map("to_addr")
  subject           String
  bodyText          String          @map("body_text")
  type              String          // new_login | location_change | password_changed | email_changed | name_changed | photo_changed | restriction | email_verify | other
  severity          String          // benign | review | danger
  status            String          @default("logged") // logged | needs_review | acknowledged | incident | resolved
  locationLabel     String?         @map("location_label")
  actionedBy        String?         @map("actioned_by")        // admin who triaged (it-was-us / we-know / wasn't-us / resolve)
  actionedAt        DateTime?       @map("actioned_at")
  incidentOpenedAt  DateTime?       @map("incident_opened_at") // set when "Wasn't us" opens an incident; kept for history after resolve
  resolution        String?                                     // short outcome note on resolve/it-was-us
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([linkedinAccountId, receivedAt])
  @@index([linkedinAccountId, status])
  @@map("account_mail_events")
}

// One on-chain payment received for an account's off-platform rental.
// txHash is unique so re-scans never double-count.
model CryptoPayment {
  id                String          @id @default(uuid()) @db.Uuid
  linkedinAccountId String          @map("linkedin_account_id") @db.Uuid
  txHash            String          @unique @map("tx_hash")
  network           String                                          // "bsc" | "tron"
  token             String                                          // e.g. "USDT"
  amount            Decimal         @db.Decimal(18, 6)
  fromAddress       String          @map("from_address")
  paidAt            DateTime        @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  account           LinkedInAccount @relation(fields: [linkedinAccountId], references: [id], onDelete: Cascade)

  @@index([linkedinAccountId, paidAt])
  @@map("crypto_payments")
}

model Rental {
  handoverAt DateTime? @map("handover_at")
  shadowExitAt DateTime? @map("shadow_exit_at")
  shadowNoticeSentAt DateTime? @map("shadow_notice_sent_at")
  shadowCreditAt DateTime? @map("shadow_credit_at")
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @map("user_id") @db.Uuid
  linkedinAccountId     String       @map("linkedin_account_id") @db.Uuid
  stripeSubscriptionId  String?      @unique @map("stripe_subscription_id")
  startDate             DateTime     @default(now()) @map("start_date")
  currentPeriodEnd      DateTime?    @map("current_period_end")
  autoRenew             Boolean      @default(true) @map("auto_renew")
  status                RentalStatus @default(active)
  accessGrantedAt       DateTime?    @map("access_granted_at")
  usdcPayment           Boolean      @default(false) @map("usdc_payment")
  // Per-rental price lock: when set, billing charges this instead of the account's
  // current listed price. Lets us raise catalogue prices while grandfathering existing
  // renters at their original rate (e.g. Nico locked at $50 while inventory lists $75).
  lockedPrice           Decimal?     @map("locked_price") @db.Decimal(10, 2)
  // Voucher code applied at checkout (audit only; the discounted rate lives in lockedPrice).
  discountCode          String?      @map("discount_code")
  accessRevokedAt       DateTime?    @map("access_revoked_at")
  paused                Boolean      @default(false)
  // GoLogin shares created for this rental, so we can revoke them on pause:
  // [{ email, shareId }] — LEGACY email-share method (kept for backward compat).
  gologinShareIds       Json         @default("[]") @map("gologin_share_ids")
  // Current public g.camp share link for this rental (the access mechanism).
  // linkId = GoLogin _id used to pause/delete; url = full openable g.camp link.
  // Regenerated per rental; deleted (and cleared) on revoke/expire/end.
  gologinShareLinkId    String?      @map("gologin_share_link_id")
  gologinShareLinkUrl   String?      @map("gologin_share_link_url")
  // Admin-only tracker fields (match the internal Renter sheet).
  campaignGoal          String?      @map("campaign_goal")
  // LinkedVelocity point of contact — who owns this renter relationship.
  lvPoc                 String?      @map("lv_poc")
  // Which renewal-cadence emails have fired this cycle (e.g. ["reminder_3d","grace"]);
  // cleared on renewal. Prevents duplicate sends from the daily cron.
  renewalRemindersSent  Json         @default("[]") @map("renewal_reminders_sent")
  // Auto-grant retry counter: how many times the cron has tried to share GoLogin
  // access (the renter must have set up GoLogin first). Bounded to avoid looping.
  accessGrantAttempts   Int          @default(0) @map("access_grant_attempts")
  // Shadow rental (see User.isShadowRenter): billed at the flat shadow rate, does NOT
  // flip the account to "rented" (stays catalogue-available), and is auto-yielded when
  // a real customer rents the same account.
  isShadow              Boolean      @default(false) @map("is_shadow")
  // Self-serve replacement: when a restricted account is swapped out, the NEW rental points
  // back to the OLD one here, and the old rental's status becomes "replaced". Keeps account
  // counts honest and makes "what replaced what" unambiguous even if the old account recovers.
  replacesRentalId      String?      @map("replaces_rental_id") @db.Uuid
  replaces              Rental?      @relation("RentalReplacement", fields: [replacesRentalId], references: [id], onDelete: SetNull)
  replacedBy            Rental[]     @relation("RentalReplacement")
  // Renter chose to keep waiting for recovery instead of replacing a restricted account
  // (set from the dashboard once past the 2-day hold); cleared on recover or replace.
  waitingForRecovery    Boolean      @default(false) @map("waiting_for_recovery")
  waitChosenAt          DateTime?    @map("wait_chosen_at")
  // Banked downtime-credit days added to this rental's renewal date, ANY cause (LinkedIn
  // restriction recovery, a swap, or our own proxy/infra outage). Cause-agnostic running
  // total — incremented wherever currentPeriodEnd is pushed out for downtime we owe.
  downtimeCreditDays    Int          @default(0) @map("downtime_credit_days")
  notes                 String?
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user                  User            @relation(fields: [userId], references: [id])
  linkedinAccount       LinkedInAccount @relation(fields: [linkedinAccountId], references: [id])
  transactions          Transaction[]

  @@index([replacesRentalId])
  @@map("rentals")
}

model Waitlist {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  linkedinAccountId String          @map("linkedin_account_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  user              User            @relation(fields: [userId], references: [id])
  linkedinAccount   LinkedInAccount @relation(fields: [linkedinAccountId], references: [id])

  @@unique([userId, linkedinAccountId])
  @@map("waitlist")
}

enum AmbassadorStatus {
  pending
  reviewing
  approved
  rejected
  onboarding
  onboarded
  unreachable
  contacted
  on_hold
}

model AmbassadorApplication {
  applicationReceived Boolean @default(true) @map("application_received")
  scheduledMeeting ScheduledMeeting?
  submittedByUserId String? @map("submitted_by_user_id") @db.Uuid
  submittedBy User? @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  selfServiceOnboarding SelfServiceOnboarding?
  id                String           @id @default(uuid()) @db.Uuid
  fullName          String           @map("full_name")
  email             String
  linkedinEmail     String?          @map("linkedin_email")
  contactNumber     String?          @map("contact_number")
  linkedinUrl       String           @map("linkedin_url")
  connectionCount   Int?             @map("connection_count")
  industry          String?
  location          String?
  notes             String?
  referralSource    String?          @map("referral_source")
  referredBy        String?          @map("referred_by")
  // This account owner is ALSO a referrer (same human) — links to their Referrer row so
  // contact + payout info are shared and payouts treat them as one payee. Distinct from
  // referredBy, which is the slug of whoever referred THIS signup. Null = not a referrer.
  referrerId        String?          @map("referrer_id") @db.Uuid
  asReferrer        Referrer?        @relation("AmbassadorIsReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  status            AmbassadorStatus @default(pending)
  offeredAmount     Decimal?         @map("offered_amount") @db.Decimal(10, 2)
  adminNotes        String?          @map("admin_notes")
  paymentMethod     String?          @map("payment_method")
  bankName          String?          @map("bank_name")
  bankAccountName   String?          @map("bank_account_name")
  bankAccountNumber String?          @map("bank_account_number")
  bankRoutingNumber String?          @map("bank_routing_number")
  bankSortCode      String?          @map("bank_sort_code")
  usdcWalletAddress String?          @map("usdc_wallet_address")
  usdcNetwork       String?          @map("usdc_network")
  paypalEmail       String?          @map("paypal_email")
  wiseEmail         String?          @map("wise_email")
  // Owner operational status on the Account Owners page: active/onboarding/paused/lost.
  ownerStatus       String?          @map("owner_status")
  // Per-owner payout currency override ("PHP" | "USD"). Null = inherit from the
  // referrer's currency (see referral-currency.ts). Lets an ambassador be pinned to
  // a currency regardless of who referred them (e.g. an Indian ambassador on the USD
  // offer who was signed up by a PH referrer).
  payoutCurrency    String?          @map("payout_currency")
  // Preferred contact channel (WhatsApp/Telegram/Messenger/Email/Viber); handle = contactNumber.
  contactChannel    String?          @map("contact_channel")
  // Set when the account can't be logged into (restricted / wrong password / etc.) —
  // holds the reason and blocks payouts until resolved. Null = fine.
  accountIssue      String?          @map("account_issue")
  // Manual hold on the referrer's commission for this signup: when set, the referral drops
  // out of "due now" on the payouts view into a Held section (with this reason) until released,
  // without un-earning it. For blockers like a restricted referred account or a referrer with
  // no payout method saved. Cleared to put it back on the due list.
  referralHoldReason String?         @map("referral_hold_reason")
  referralHeldAt    DateTime?         @map("referral_held_at")
  // Free-text payout handle (e.g. a GCash number) shown alongside paymentMethod.
  paymentDetails    String?          @map("payment_details")
  // Legal/registered account-holder name for the payout method — must match the name
  // on the GCash / bank account or the transfer is rejected.
  payoutName        String?          @map("payout_name")
  // Recurring ₱500/month payout log: [{ paidAt: ISO, amount: number, note?: string }].
  // The one-time ₱1,000 setup fee's paid date is `paidAt` above.
  monthlyPayouts    Json?            @map("monthly_payouts")
  poc               String?          @map("poc")
  outreachLog       Json?            @map("outreach_log")
  nextFollowUp      DateTime?        @map("next_follow_up")
  callOutcome       String?          @map("call_outcome")
  bookingEmail      String?          @map("booking_email")
  verifiedAt        DateTime?         @map("verified_at")
  qcChecks          Json?             @map("qc_checks") // { photo, headline, about, connections, experiences, education } booleans — the QC checklist behind verifiedAt
  emailPrimaryAt    DateTime?         @map("email_primary_at")
  onboardingStartedAt DateTime?       @map("onboarding_started_at")
  onboardedAt       DateTime?         @map("onboarded_at")
  // How a DIY (self-service) onboarding was completed: "computer" (referrer signed in)
  // or "phone" (handed off to LV). Drives the tiered referral commission. Null for
  // plain referrals (LV onboards) and pre-tier rows.
  onboardingMethod  String?          @map("onboarding_method")
  // DIY landing page tier the owner chose: "standard" (₱1,000 sign-on, we set it up),
  // "partial" (₱1,500, they add email+2FA), "full" (₱2,000, they do it all incl. GoLogin).
  // Drives the sign-on bonus paid; null for non-DIY signups.
  diyTier           String?          @map("diy_tier")
  // Snapshot of the account's LinkedIn ID-verified state AT onboarding. The referral
  // commission is locked to this — verifying the account later does NOT change what the
  // referrer earned. Null for plain referrals / pre-tier rows.
  onboardingVerified Boolean?        @map("onboarding_verified")
  // Post-sign-in fixes the team needs the referrer to do (e.g. our email isn't set as
  // primary, or 2FA isn't set up). Surfaced on the referrer's portal, cleared by the team
  // after a recheck. Shape: { issues: ("email_primary"|"twofa")[], state: "open"|"referrer_done",
  // raisedAt: ISO, doneAt?: ISO }. Null when there's nothing outstanding.
  onboardingFix     Json?             @map("onboarding_fix")
  // The referrer's own report about a LinkedIn restriction on their referred account,
  // sent from their portal so the team knows to verify. It does NOT auto-clear our
  // restriction record (restrictedAt / restrictionLog stay the system of truth until the
  // team confirms). Shape: { type: "qr_done"|"recovered", at: ISO }. Null = no report.
  restrictionReport Json?             @map("restriction_report")
  accountFreshness  String?          @map("account_freshness")
  paidAt            DateTime?         @map("paid_at")
  marketerPaidAt    DateTime?         @map("marketer_paid_at")
  fastTrackSentAt   DateTime?         @map("fast_track_sent_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([submittedByUserId])
  @@index([referrerId])
  @@map("ambassador_applications")
}

// A field marketer / ambassador who refers signups. `slug` is the ?ref= value in
// their QR; `token` is the secret for their portal link /m/<token>. Self-editable
// fields (contact, payment) are filled by them via the portal.
model Referrer {
  displayCurrency String @default("USD") @map("display_currency")
  selfServiceOnboardings SelfServiceOnboarding[]
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  token            String   @unique
  name             String
  type             String   @default("marketer")
  channel          String?
  contactMethod    String?  @map("contact_method")
  contactHandle    String?  @map("contact_handle")
  contacts         Json?    // [{ method, handle, preferred? }] — preferred one is mirrored into contactMethod/contactHandle
  email            String?
  paymentMethod    String?  @map("payment_method")
  paymentDetails   String?  @map("payment_details")
  paymentName      String?  @map("payment_name") // account-holder / registered name on the payout account (may differ from `name`)
  assignedDay      String?  @map("assigned_day")
  assignedLocation String?  @map("assigned_location")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  payouts          Payout[]
  // Ambassador account(s) owned by this same person (they are both a referrer and an
  // account owner). Lets the two sides share contact + payout info. See AmbassadorApplication.asReferrer.
  ambassadorAccounts AmbassadorApplication[] @relation("AmbassadorIsReferrer")

  @@map("referrers")
}

// Do-not-contact list for referral outreach, keyed by email. A person on here is never
// shown as contactable on /admin/referral-outreach and the send endpoint refuses them.
model OutreachSuppression {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  reason    String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outreach_suppression")
}

// One row per payment owed to a marketer. Cash leaves no trace, so the row carries
// BOTH sides: what we say we paid (paidAt/method/reference) and the marketer's own
// acknowledgement from their portal (confirmedAt) — that second half is the evidence.
model Payout {
  id          String    @id @default(uuid()) @db.Uuid
  referrerId  String    @map("referrer_id") @db.Uuid
  referrer    Referrer  @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  type        String    @default("day_rate") // day_rate | commission | bonus | other
  ambassadorApplicationId String? @map("ambassador_application_id") @db.Uuid // commission: the specific referred application this pays for
  description String?
  amount      Decimal   @db.Decimal(10, 2)
  method      String?   // cash | gcash | bank
  reference   String?   // GCash reference no. / receipt
  paidAt      DateTime? @map("paid_at")
  paidBy      String?   @map("paid_by")
  notifiedAt  DateTime? @map("notified_at") // when the payee was auto-emailed the receipt
  confirmedAt DateTime? @map("confirmed_at")
  confirmedBy String?   @map("confirmed_by") // name the marketer typed when confirming
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([referrerId])
  @@map("payouts")
}

enum TransactionType {
  deposit
  rental_payment
  sweep
  refund
  adjustment
}

model DepositAddress {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  address          String   @unique
  derivationIndex  Int      @unique @map("derivation_index")
  lastSeenBalance  Decimal  @default(0) @map("last_seen_balance") @db.Decimal(18, 6)
  createdAt        DateTime @default(now()) @map("created_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deposit_addresses")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 6)
  txHash      String?         @map("tx_hash")
  rentalId    String?         @map("rental_id") @db.Uuid
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")

  user        User            @relation(fields: [userId], references: [id])
  rental      Rental?         @relation(fields: [rentalId], references: [id])

  @@map("transactions")
}

// Inbound leads — people who proactively reach out (Telegram messages, call
// bookings). One row per person per channel (upserted). Powers the live
// "Inbound" admin tab + Google Sheet. Signups/customers live elsewhere (not inbound).
model InboundLead {
  phone String?
  company String?
  jobTitle String? @map("job_title")
  website String?
  linkedinUrl String? @map("linkedin_url")
  country String?

  ambassadorApplicationId String? @map("ambassador_application_id") @db.Uuid
  referrerId String? @map("referrer_id") @db.Uuid
  addedToAmbassadorPipeline Boolean @default(false) @map("added_to_ambassador_pipeline")
  addedToReferralPipeline Boolean @default(false) @map("added_to_referral_pipeline")
  addedToClientCrm Boolean @default(false) @map("added_to_client_crm")
  id             String   @id @default(uuid()) @db.Uuid
  channel        String                                  // platform: "telegram" | "website" | "call" | ...
  name           String                                  // name or @username
  handle         String?                                 // @username (telegram)
  contact        String?                                 // telegram chat id (internal dedup key)
  companyEmail   String?  @map("company_email")           // their company / email
  type           String?                                 // "Potential Renter" | "Potential Ambassador" | ...
  message        String?                                 // use case / latest message
  status         String   @default("new")
  replied        Boolean  @default(false)
  followUpDate   DateTime? @map("follow_up_date")
  outcome        String?
  source         String?
  notes          String?
  stage          String   @default("new")                    // CRM pipeline: new | warm | active | cold | lost
  ownerEmail     String?  @map("owner_email")                 // who on the team owns this relationship
  commsLog       Json?    @map("comms_log")                   // timestamped touchbase timeline: [{ ts, channel, body }]
  // AI running summary of the comms_log — one concise paragraph ("what happened + where it
  // stands"), regenerated when there's a newer touchpoint than commsSummaryAt. Keeps the CRM /
  // Renters timeline scannable instead of a long per-message dump. See src/lib/crm-summary.ts.
  commsSummary   String?  @map("comms_summary")
  commsSummaryAt DateTime? @map("comms_summary_at")
  messageCount   Int      @default(1)  @map("message_count")
  firstContactAt DateTime @default(now()) @map("first_contact_at")
  lastContactAt  DateTime @default(now()) @map("last_contact_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([channel, contact])
  @@map("inbound_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// Renters v3 — unified "Person" overlay (Phase 1)
//
// crm_people is the single front-of-house record spanning lead → signup → renting →
// dormant. It OVERLAYS, not replaces: `userId` links to the renter/billing spine (User)
// once they have an account; `inboundLeadId` links to the originating inbound lead so the
// Telegram/booking ingestion keeps writing inbound_leads untouched and we reconcile here.
// Renter-operational fields (vetting/cap/sign-in/test) stay single-source on User; the
// drawer writes them through userId. Conversations replace the comms_log JSON timeline.
// ─────────────────────────────────────────────────────────────────────────────
model Company {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  domain        String?  @unique
  mainContactId String?  @map("main_contact_id") @db.Uuid   // a Person.id
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  people        Person[]
  @@map("companies")
}

model Person {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid          // → User once they have an account
  inboundLeadId  String?   @unique @map("inbound_lead_id") @db.Uuid  // → originating InboundLead
  name           String
  email          String?                                             // nullable: TG-only leads have none
  channel        String?                                             // 'WA' | 'TG' | null
  contact        String?                                             // phone or @handle
  companyId      String?   @map("company_id") @db.Uuid
  role           String?
  source         String?
  pocOwner       String?   @map("poc_owner")                         // 'Ardi'|'Milee'|'Sam'|null
  followUp       DateTime? @map("follow_up")
  leadStage      String?   @map("lead_stage")                        // 'warm'|'cold'|null
  isTest         Boolean   @default(false) @map("is_test")           // leads only; linked persons use User.isTest
  notes          String?
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  @@index([companyId])
  @@index([lastActivityAt])
  @@map("crm_people")
}

model Conversation {
  id          String   @id @default(uuid()) @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  type        String   // 'Note'|'Call'|'WhatsApp'|'Telegram'|'Email'
  text        String
  direction   String?  // inbound|outbound (carried from legacy comms_log)
  authorName  String?  @map("author_name")
  authorEmail String?  @map("author_email")
  externalId  String?  @map("external_id")  // dedup key = comms_log entry id / notes requestId
  createdAt   DateTime @default(now()) @map("created_at")
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  @@index([personId, createdAt])
  @@map("conversations")
}

model DuplicateSuggestion {
  id          String    @id @default(uuid()) @db.Uuid
  personAId   String    @map("person_a_id") @db.Uuid
  personBId   String    @map("person_b_id") @db.Uuid
  reason      String    // same-name | same-email-localpart | same-phone | same-domain | same-day-signup
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  @@unique([personAId, personBId])
  @@map("duplicate_suggestions")
}

model BlogPost {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  title         String
  description   String    @default("")
  category      String    @default("LinkedIn Strategy")
  priority      String    @default("P2")                   // idea priority: P1 | P2 | P3
  keyword       String?                                    // target SEO keyword
  pillar        String?                                    // content pillar
  content       String    @default("")                     // markdown body
  readTime      String?   @map("read_time")
  status        String    @default("draft")                // draft | in_review | approved | published
  scheduledFor  DateTime? @map("scheduled_for")            // calendar / target publish date
  publishedAt   DateTime? @map("published_at")
  authorEmail   String?   @map("author_email")
  reviewerNotes String?   @map("reviewer_notes")           // Sam's review feedback
  linkedinPost     String?   @map("linkedin_post")         // repurposed LinkedIn caption (optional)
  linkedinPostedAt DateTime? @map("linkedin_posted_at")    // when it was shared to LinkedIn
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

// One row per calendar day: a snapshot of the headline run-rate metrics, so the
// dashboard can show past months + month-over-month trends. Written by the
// /api/cron/snapshot-metrics daily cron. Only starts from the day it's turned on
// (no historical backfill is possible — we never recorded it before).
model MetricsSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  date               DateTime @unique @db.Date
  mrr                Float    @default(0)
  netProfit          Float    @default(0) @map("net_profit")
  payouts            Float    @default(0)
  activeRentals      Int      @default(0) @map("active_rentals")
  totalCustomers     Int      @default(0) @map("total_customers")
  totalAccounts      Int      @default(0) @map("total_accounts")
  availableAccounts  Int      @default(0) @map("available_accounts")
  rentedAccounts     Int      @default(0) @map("rented_accounts")
  offlineAccounts    Int      @default(0) @map("offline_accounts")
  restrictedAccounts Int      @default(0) @map("restricted_accounts")
  utilization        Int      @default(0)
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("metrics_snapshots")
}

// Per-proxy metadata lookup, keyed by host:port. The account→proxy mapping itself
// lives on LinkedInAccount (proxyHost/Port/Username/Password); this table only holds
// the things that AREN'T derivable from an account — the friendly label ("Germany 01"),
// which provider it came from (Proxy 6 / proxy-cheap), whether it's residential or
// datacenter, and a manual status flag (e.g. a dead "Error Proxy"). The admin Proxies
// page and its Google-Sheets CSV export join this onto the live account data so the
// proxy tab is one source of truth, never a hand-kept copy. A row may exist with no
// linked accounts (a spare/dead proxy Sam is tracking).
model Proxy {
  selfServiceOnboardings SelfServiceOnboarding[]
  id        String   @id @default(uuid()) @db.Uuid
  host      String
  port      Int
  username  String?                                  // proxy auth (for proxies with no linked account in our DB)
  password  String?
  label     String?                                  // friendly name, e.g. "Germany 01"
  provider  String?                                  // "Proxy 6" | "proxy-cheap" | ...
  type      String?                                  // "residential" | "datacenter"
  country   String?                                  // manual override; else derived from linked accounts
  status    String?                                  // "active" | "error" | "retired" (manual flag)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([host, port])
  @@map("proxies")
}

// Durable provisioning state: retries must not allocate another proxy or profile.
model SelfServiceOnboarding {
  emailSetup OnboardingEmailSetup?
  id String @id @default(uuid()) @db.Uuid
  referrerId String @map("referrer_id") @db.Uuid
  referrer Referrer @relation(fields: [referrerId], references: [id])
  applicationId String @unique @map("application_id") @db.Uuid
  application AmbassadorApplication @relation(fields: [applicationId], references: [id])
  accountId String @unique @map("account_id") @db.Uuid
  account LinkedInAccount @relation(fields: [accountId], references: [id])
  proxyId String? @map("proxy_id") @db.Uuid
  proxySlot Int? @map("proxy_slot")
  proxy Proxy? @relation(fields: [proxyId], references: [id])
  proxyOrderId String? @unique @map("proxy_order_id")
  proxyBudgetReserved Decimal? @map("proxy_budget_reserved") @db.Decimal(10, 2)
  proxyPurchaseAt DateTime? @map("proxy_purchase_at")
  email String
  linkedinUrl String @map("linkedin_url")
  // Per-session public token for the DIY self-onboarding flow: lets the ambassador drive
  // ONLY their own session via /api/self-onboarding/<token>, without the shared referrer
  // token (which would expose other people's sessions). Null for referrer-driven sessions.
  publicToken String? @unique @map("public_token")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  reminderCount Int @default(0) @map("reminder_count")
  reminderSentAt DateTime? @map("reminder_sent_at")
  reminderClaimedAt DateTime? @map("reminder_claimed_at")
  state String @default("reserved")
  consentAt DateTime @map("consent_at")
  openedAt DateTime? @map("opened_at")
  confirmedAt DateTime? @map("confirmed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([referrerId])
  @@unique([proxyId, proxySlot])
  @@index([email])
  @@index([linkedinUrl])
  @@map("self_service_onboardings")
}

model OnboardingEmailSetup {
  sessionId String @id @map("session_id") @db.Uuid
  session SelfServiceOnboarding @relation(fields: [sessionId], references: [id])
  address String @unique
  destination String
  consentAt DateTime @map("consent_at")
  codeHash String? @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at")
  codeAttempts Int @default(0) @map("code_attempts")
  codeSends Int @default(0) @map("code_sends")
  codeSentAt DateTime? @map("code_sent_at")
  destinationVerifiedAt DateTime? @map("destination_verified_at")
  forwardingUntil DateTime? @map("forwarding_until")
  // LinkedIn's "confirm this email" link, captured from the forwarded message so the wizard
  // can show it directly (copy / open) instead of depending on the forwarded email arriving.
  confirmUrl String? @map("confirm_url")
  // Latest LinkedIn verification/OTP code parsed from a forwarded message, surfaced to the
  // account's referrer (in the wizard) and the team (admin) during onboarding ONLY. Written
  // solely while forwarding is active (session not confirmed) and cleared the moment the
  // session is confirmed / the account is onboarded, so codes are never retrievable after.
  lastCode String? @map("last_code")
  lastCodeAt DateTime? @map("last_code_at")
  primaryConfirmedAt DateTime? @map("primary_confirmed_at")
  lastForwardedAt DateTime? @map("last_forwarded_at")
  createdAt DateTime @default(now()) @map("created_at")
  messages OnboardingEmailDelivery[]
  @@map("onboarding_email_setups")
}

model OnboardingEmailDelivery {
  emailId String @id @map("email_id")
  sessionId String @map("session_id") @db.Uuid
  setup OnboardingEmailSetup @relation(fields: [sessionId], references: [sessionId])
  status String @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  leaseUntil DateTime? @map("lease_until")
  sentAt DateTime? @map("sent_at")
  @@index([sessionId])
  @@map("onboarding_email_deliveries")
}

// A per-owner onboarding invite: the referrer creates one (with the owner's name),
// gets a unique link to send, and can see whether it's been filled in yet. When the
// owner submits, the created SelfServiceOnboarding is linked back here (sessionId) so
// the referrer's status tracks the same stages the admin sees. referrerId/sessionId
// are plain columns (referrer has a FK for integrity) so no existing model changes.
model OnboardingInvite {
  id         String    @id @default(uuid()) @db.Uuid
  referrerId String    @map("referrer_id") @db.Uuid
  ownerName  String    @map("owner_name")
  token      String    @unique
  sessionId  String?   @unique @map("session_id") @db.Uuid
  filledAt   DateTime? @map("filled_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([referrerId])
  @@map("onboarding_invites")
}

// Durable purchase ledger for admin provisioning; shared budget includes DIY orders.
model ProxyPurchaseAttempt {
  accountId String @id @map("account_id") @db.Uuid
  account LinkedInAccount @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  state String
  amount Decimal @db.Decimal(10, 2)
  country String
  orderId String? @map("order_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("proxy_purchase_attempts")
}

// Renter self-serve "fix my proxy": one row per report. The renter taps "Proxy not
// working?" → we swap the proxy on their live GoLogin profile, verify it, and ask them to
// confirm. If no spare proxy is free, the new one fails its check, or the renter says it's
// still broken, the row flips to "escalated" and the team is emailed. Audit trail only —
// proxy creds here are for our records and are NEVER sent to the renter.
// Standalone scalar FKs (no relations) so adding it touches no other model.
model ProxySwap {
  id                String    @id @default(uuid()) @db.Uuid
  rentalId          String    @map("rental_id") @db.Uuid
  linkedinAccountId String    @map("linkedin_account_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  ticketRef         String    @unique @map("ticket_ref")
  status            String    @default("fixing") // fixing | swapped | confirmed | escalated | resolved
  oldProxyHost      String?   @map("old_proxy_host")
  oldProxyPort      Int?      @map("old_proxy_port")
  newProxyHost      String?   @map("new_proxy_host")
  newProxyPort      Int?      @map("new_proxy_port")
  escalationReason  String?   @map("escalation_reason") // no_proxy_available | verify_failed | renter_still_broken | error
  createdAt         DateTime  @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")
  @@index([userId, status])
  @@index([rentalId, createdAt])
  @@map("proxy_swaps")
}

// Short-lived owner-verified recovery for an existing assigned LV email.
model PrimaryEmailRecovery {
  id String @id
  accountId String? @map("account_id") @db.Uuid
  account LinkedInAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  address String?
  destination String
  ipHash String @map("ip_hash")
  codeHash String @map("code_hash")
  attempts Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  forwardingUntil DateTime? @map("forwarding_until")
  completedAt DateTime? @map("completed_at")
  lastForwardedAt DateTime? @map("last_forwarded_at")
  messages PrimaryEmailDelivery[]
  @@index([destination, createdAt])
  @@index([ipHash, createdAt])
  @@index([address, forwardingUntil])
  @@map("primary_email_recoveries")
}

model PrimaryEmailDelivery {
  emailId String @id @map("email_id")
  recoveryId String @map("recovery_id")
  recovery PrimaryEmailRecovery @relation(fields: [recoveryId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  leaseUntil DateTime? @map("lease_until")
  sentAt DateTime? @map("sent_at")
  @@index([recoveryId])
  @@map("primary_email_deliveries")
}

model AccountCodeLink {
  tokenHash String @id @map("token_hash")
  accountId String @map("account_id") @db.Uuid
  account LinkedInAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("account_code_links")
}

model InboundBooking {
  key         String   @id
  leadId      String   @map("lead_id") @db.Uuid
  eventId     String   @map("event_id")
  email       String
  scheduledAt DateTime @map("scheduled_at")
  cancelled   Boolean  @default(false)
  fingerprint String
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([leadId])
  @@map("inbound_bookings")
}

model InboundLeadArchive {
  id             String   @id @default(uuid()) @db.Uuid
  channel        String                                  // platform: "telegram" | "website" | "call" | ...
  name           String                                  // name or @username
  handle         String?                                 // @username (telegram)
  contact        String?                                 // telegram chat id (internal dedup key)
  companyEmail   String?  @map("company_email")           // their company / email
  type           String?                                 // "Potential Renter" | "Potential Ambassador" | ...
  message        String?                                 // use case / latest message
  status         String   @default("new")
  replied        Boolean  @default(false)
  followUpDate   DateTime? @map("follow_up_date")
  outcome        String?
  source         String?
  notes          String?
  stage          String   @default("new")                    // CRM pipeline: new | warm | active | cold | lost
  ownerEmail     String?  @map("owner_email")                 // who on the team owns this relationship
  commsLog       Json?    @map("comms_log")                   // timestamped touchbase timeline: [{ ts, channel, body }]
  messageCount   Int      @default(1)  @map("message_count")
  firstContactAt DateTime @default(now()) @map("first_contact_at")
  lastContactAt  DateTime @default(now()) @map("last_contact_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("inbound_leads_archive")
}

model ScheduledMeeting {
  sequence Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  id String @id @default(uuid()) @db.Uuid
  applicationId String? @unique @map("application_id") @db.Uuid
  application AmbassadorApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name String
  email String
  contact String
  host String
  startsAt DateTime @map("starts_at")
  inviteSentAt DateTime? @map("invite_sent_at")
  inviteDelivery String? @map("invite_delivery")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([host, startsAt])
  @@map("scheduled_meetings")
}

// Every LinkedIn email we receive at one of our onboarding domains — captured regardless of
// whether the address went through the self-service wizard, so the team can read the confirm
// link / verification code for a manually-added email too. See /admin/onboarding-codes.
model CapturedVerification {
  id String @id @default(uuid()) @db.Uuid
  emailId String @unique @map("email_id") // Resend receiving id — idempotency key
  address String // recipient on our domain, lowercased
  fromAddr String @map("from_addr")
  subject String?
  confirmUrl String? @map("confirm_url")
  code String?
  receivedAt DateTime @map("received_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([address])
  @@index([receivedAt])
  @@map("captured_verifications")
}
