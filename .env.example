# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linkedin_ambassadors"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# GoLogin
GOLOGIN_API_TOKEN=""

# Resend (Email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@linkedinambassadors.com"

# File Storage (S3/R2)
S3_BUCKET_NAME=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# GitHub (for desktop app download)
GITHUB_TOKEN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: workspace id for the master/ortus GoLogin account. Leave unset if master
# profiles are personal (no workspace) — shares then send no currentWorkspace param.
GOLOGIN_WORKSPACE_ID_MASTER=""
# Self-service onboarding (server-only; leave purchases off until limits are approved)
GOLOGIN_API_TOKEN_KLABBER=
PROXY_CHEAP_API_KEY=
PROXY_CHEAP_API_SECRET=
PROXY_CHEAP_AUTO_BUY=false
PROXY_CHEAP_MAX_PER_PROXY_USD=4
PROXY_CHEAP_MONTHLY_BUDGET_USD=100
## Onboarding inbound email (off until migration, DNS, webhook and delivery tests pass)
ONBOARDING_EMAIL_ENABLED=false
ONBOARDING_EMAIL_FROM="LinkedVelocity <info@linkedvelocity.com>"
ONBOARDING_EMAIL_DOMAINS=
ONBOARDING_EMAIL_CODE_SECRET=
RESEND_INBOUND_WEBHOOK_SECRET=

# Mobile ownership checks during self-service onboarding (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFICATION_SECRET=

# Wise read-only CLI: configure in .env.wise.local or runtime secrets (see docs/wise.md)
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Profile Maturing auto-start (see docs/profile-maturing.md). Off unless MATURING_AUTOSTART=on.
# When on, the auto-start-maturing cron starts an aggressive warm-only campaign for each
# Level-4 (QC-passed) account that has never been matured, up to MATURING_AUTOSTART_MAX per run.
MATURING_AUTOSTART=
MATURING_AUTOSTART_MAX=5
