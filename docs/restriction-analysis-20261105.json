  "methodology": {
    "population": "LinkedVelocity application records uniquely matched to inventory by session, unique LinkedIn URL, or unique owner email; ambiguous duplicate account links excluded.",
    "restriction": "Dated restricted events plus current restrictedAt; recovered accounts retained. Dates reflect recorded events, not necessarily exact onset.",
    "primaryMilestone": "paid_at (setup payment), not onboarded_at, which can represent an earlier setup milestone.",
    "followup": "Each 7/14/30/60-day rate only includes records whose milestone occurred at least that many days before extract. No recorded event is not proof of continuous unrestricted access.",
    "classification": "Recorded account_freshness; not independently verified age. 88 matched accounts have no label.",
    "caution": "Descriptive association, unequal calendar cohorts and small fresh 30-day sample. Do not infer that delaying payout prevents restrictions or that all payments on restricted accounts were lost."
  },
  "proposal": {
    "userClarification": "One month for newly created LinkedIn accounts, one week for established profiles.",
    "implemented": false,
    "finding": "Paid fresh and established accounts have similarly high recorded 30-day restriction rates. Data does not support treating established profiles as low risk after seven days.",
    "suggestions": [
      "Pilot a longer qualification period for both groups rather than assume established profiles are safe at day seven.",
      "Consider prospective staged setup payments tied to verified usable service, while honoring existing commitments.",
      "Require a fresh health check and resolved restriction evidence before onboarding/payment.",
      "Measure 30-day restrictions and net usable days after payment by acquisition cohort, actual account age, prior restrictions and operational activity.",
      "Investigate policy-triggering activity; waiting alone does not establish safe future use."
    ]
  }
