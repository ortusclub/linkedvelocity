{
  "buildCommand": "npx prisma migrate deploy && npx prisma generate && npm run build",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/detect-deposits",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/proxy-health",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/release-holds",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-renewals",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/auto-grant",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/snapshot-metrics",
      "schedule": "55 23 * * *"
    },
    {
      "path": "/api/cron/check-weekly-payments",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/check-daily-payments",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/overdue-rentals-alert",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/renewal-watchdog",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron/stripe-recon",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/payments-due-digest",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/fast-track-invites",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/crypto-payments",
      "schedule": "20 9 * * *"
    },
    {
      "path": "/api/cron/reengage-signups",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/provision-accounts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-inbound-bookings",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/onboarding-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reconcile-maturing",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/auto-start-maturing",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/poll-appeal-mail",
      "schedule": "*/15 * * * *"
    }
  ]
}
